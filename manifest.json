{
  "name": "LeetBridge",
  "description": "Sync accepted LeetCode solutions to GitHub.",
  "version": "0.2.1",
  "manifest_version": 3,

  "permissions": [
    "tabs"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "content/page/submission-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "content/extractors/problem-name.js",
        "content/extractors/problem-number.js",
        "content/extractors/difficulty.js",
        "content/extractors/username.js",
        "content/extractors/submission-status.js",
        "content/extractors/problem-code.js",
        "content/leetcode.js"
      ]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "resources/LeetBridge-logo.png"
  }
}
