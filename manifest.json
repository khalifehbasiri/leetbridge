{
  "name": "LeetBridge",
  "description": "Automatically sync accepted LeetCode solutions to a polished GitHub repository.",
  "version": "1.0.0",
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "incognito": "not_allowed",
  "homepage_url": "https://github.com/khalifehbasiri/leetbridge",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content/page/submission-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content/extractors/problem-name.js",
        "content/extractors/problem-number.js",
        "content/extractors/difficulty.js",
        "content/extractors/username.js",
        "content/extractors/submission-status.js",
        "content/extractors/problem-code.js",
        "content/extractors/submission-language.js",
        "content/leetcode.js"
      ]
    }
  ],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "resources/icon16.png",
      "32": "resources/icon32.png",
      "48": "resources/icon48.png"
    }
  },

  "icons": {
    "16": "resources/icon16.png",
    "32": "resources/icon32.png",
    "48": "resources/icon48.png",
    "128": "resources/icon128.png"
  }
}
