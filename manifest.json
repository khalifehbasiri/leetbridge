{
  "name": "LeetBridge",
  "description": "Sync accepted LeetCode solutions to GitHub.",
  "version": "0.5.0",
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "incognito": "not_allowed",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content/page/submission-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content/extractors/problem-name.js",
        "content/extractors/problem-number.js",
        "content/extractors/difficulty.js",
        "content/extractors/username.js",
        "content/extractors/submission-status.js",
        "content/extractors/problem-code.js",
        "content/extractors/submission-language.js",
        "content/leetcode.js"
      ]
    }
  ],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "resources/LeetBridge-logo.png"
  },

  "icons": {
    "128": "resources/LeetBridge-logo.png"
  }
}
